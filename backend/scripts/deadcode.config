# 默认 deadcode 扫描规则（可按需自行覆盖）
: "${DEADCODE_PROFILE:=balanced}"

# vulture 规则
: "${VULTURE_MIN_CONFIDENCE:=95}"
: "${VULTURE_EXCLUDE:=tests/**,lab/**}"

# ruff 规则（多个规则用逗号分隔）
# 平衡模式默认先抓最关键的问题（降低误报）
: "${RUFF_SELECT:=F401,F841,F811}"

# 若需要，可在这里追加额外参数（例如 --verbose）
: "${VULTURE_EXTRA_ARGS:=}"
: "${RUFF_EXTRA_ARGS:=}"
: "${DEPTRY_EXTRA_ARGS:=--package-module-name-map duckdb-engine=duckdb_engine,futu-api=futu,python-dateutil=dateutil,beautifulsoup4=bs4,ib-insync=ib_insync}"
