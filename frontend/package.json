{
  "name": "quant_web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "antd": "^5.12.5",
    "axios": "^1.6.2",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.3",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "eslint": "^7.32.0",
    "eslint-config-react-app": "^7.0.1",
    "knip": "^6.16.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint:all": "eslint src --ext .js,.jsx",
    "deadcode:eslint": "eslint src --ext .js,.jsx",
    "deadcode:knip": "npx knip",
    "deadcode:depcheck": "npx depcheck",
    "deadcode": "npm run deadcode:eslint && npm run deadcode:knip && npm run deadcode:depcheck"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
